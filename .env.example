# LLM 服务商标识，仅用于日志和展示，不负责选择 API 路由。
LLM_PROVIDER=KIMI
# OpenAI-compatible Chat Completions API 密钥。填写你自己的密钥，不要提交到 Git。
LLM_API_KEY=
# 服务商 API 根地址，通常以 /v1 结尾。
LLM_BASE_URL=https://api.moonshot.cn/v1
# 服务端实际支持的模型名称。
LLM_MODEL=kimi-k2.6
# 单次模型回答的最大 token 数；较大的值可能增加响应时间和费用。
LLM_MAX_TOKENS=16384

# 可选 HTTP/HTTPS 代理。留空时 HTTPX 使用系统 HTTP_PROXY/HTTPS_PROXY 等环境变量。
# Docker 中不要填写 127.0.0.1 指向宿主机代理，可改用 http://host.docker.internal:7890。
PAPER_AGENT_HTTP_PROXY=

# 执行策略：auto（LLM 失败回退模板）、llm（强制调用，失败报错）、template（本地模板）。
#PAPER_AGENT_REVIEW_PROVIDER=auto
# 是否对规则无法确定的 Evidence 支持度/主题相关性调用 LLM 审核；默认关闭以控制请求量。
PAPER_AGENT_REVIEW_LLM_ENABLED=false
PAPER_AGENT_EVIDENCE_PROVIDER=llm
PAPER_AGENT_SYNTHESIS_PROVIDER=llm

# 单次外部 HTTP 请求超时时间，单位为秒。
PAPER_AGENT_REQUEST_TIMEOUT=30
# 单个 PDF 最大下载体积，单位为字节；当前为 50 MiB。
PAPER_AGENT_MAX_PDF_BYTES=52428800
# 每篇论文最多保留的 claims 数量。
PAPER_AGENT_MAX_CLAIMS_PER_PAPER=10
# 每次任务的 Markdown、BibTeX、Evidence 等产物输出目录。
PAPER_AGENT_OUTPUT_DIR=outputs/paper-agent

# Semantic Scholar API Key，可选；配置后可获得更稳定的请求配额。
SEMANTIC_SCHOLAR_API_KEY=
# Semantic Scholar 请求的客户端标识，建议填写项目名和联系邮箱。
SEMANTIC_SCHOLAR_USER_AGENT=PaperAgent/0.3 (Contact: researcher@example.com; Project: PaperAgent)

# OpenAlex API Key，可选；未配置时会尝试匿名额度。
OPENALEX_API_KEY=

# SQLite 数据库、下载的公开 PDF 和 FAISS 索引所在目录。
PAPER_AGENT_DATA_DIR=data
# FAISS 向量维度，必须与当前实现一致；默认 384。
PAPER_AGENT_VECTOR_DIMENSION=384
